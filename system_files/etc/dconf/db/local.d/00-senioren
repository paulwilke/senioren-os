# Senioren-OS: calm, Mac-like settings for GNOME.
# EVERY value in this file is locked automatically during the build
# (build.sh generates locks/00-senioren-auto from it). The user cannot change them.
# To change: here in the repo, or locally as admin in /etc/dconf + "sudo dconf update".

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com']
disable-user-extensions=false
disable-extension-version-validation=false
favorite-apps=['org.mozilla.firefox.desktop', 'net.thunderbird.Thunderbird.desktop', 'com.rtosta.zapzap.desktop', 'com.cassidyjames.butler.desktop', 'org.libreoffice.LibreOffice.writer.desktop', 'org.libreoffice.LibreOffice.calc.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Loupe.desktop', 'com.rustdesk.RustDesk.desktop']
welcome-dialog-last-shown-version='999'

# No "Run a command" (Alt+F2), no keyboard shortcut experiments
[org/gnome/desktop/lockdown]
disable-command-line=true
disable-printing=false
disable-lock-screen=false
user-administration-disabled=true

# Dock at the bottom, always visible, large icons – like on the Mac
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
intellihide=false
autohide=false
extend-height=false
dash-max-icon-size=56
icon-size-fixed=true
show-trash=true
show-mounts=true
show-show-apps-button=true
show-apps-at-top=false
click-action='minimize-or-previews'
scroll-action='do-nothing'
running-indicator-style='DOTS'
transparency-mode='FIXED'
background-opacity=0.7
custom-theme-shrink=true
disable-overview-on-startup=true
hot-keys=false

[org/gnome/desktop/interface]
color-scheme='default'
accent-color='blue'
icon-theme='WhiteSur-light'
cursor-theme='WhiteSur-cursors'
cursor-size=32
font-name='Inter 11'
document-font-name='Inter 11'
text-scaling-factor=1.2
enable-hot-corners=false
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true
locate-pointer=true

# Window buttons on the left: close, minimize, maximize
[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
action-double-click-titlebar='toggle-maximize'
num-workspaces=1

[org/gnome/mutter]
dynamic-workspaces=false
center-new-windows=true
edge-tiling=false

# German Mac keyboard, natural scrolling and tap-to-click like on the Mac
[org/gnome/desktop/input-sources]
sources=[('xkb', 'de+mac')]

[org/gnome/desktop/peripherals/touchpad]
natural-scroll=true
tap-to-click=true
two-finger-scrolling-enabled=true
click-method='fingers'

[org/gnome/desktop/peripherals/mouse]
natural-scroll=false

# Do not keep locking the screen; blank after 15 minutes
[org/gnome/desktop/session]
idle-delay=uint32 900

# Own calm wallpaper (light and dark identical)
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/senioren-os/huegel.svg'
picture-uri-dark='file:///usr/share/backgrounds/senioren-os/huegel.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
lock-enabled=false
picture-uri='file:///usr/share/backgrounds/senioren-os/huegel.svg'

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-timeout=1800
power-button-action='interactive'

# The system handles updates itself – no update notifications for the user
[org/gnome/software]
download-updates=false
download-updates-notify=false
allow-updates=false
first-run=false

# Accessibility menu always in the top bar: zoom, high contrast, large text, screen reader
[org/gnome/desktop/a11y]
always-show-universal-access-status=true

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
open-folder-on-dnd-hover=false

[org/gnome/nautilus/icon-view]
default-zoom-level='large'

[org/gnome/desktop/privacy]
remember-recent-files=true
remove-old-trash-files=true
old-files-age=uint32 30
