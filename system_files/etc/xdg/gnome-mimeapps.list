# Which app opens a file on double-click (PDF in Papers, not in Firefox)
[Default Applications]
application/pdf=org.gnome.Papers.desktop
video/mp4=org.gnome.Showtime.desktop
video/quicktime=org.gnome.Showtime.desktop
video/x-msvideo=org.gnome.Showtime.desktop
video/x-matroska=org.gnome.Showtime.desktop
video/webm=org.gnome.Showtime.desktop
video/mpeg=org.gnome.Showtime.desktop
video/3gpp=org.gnome.Showtime.desktop
video/x-m4v=org.gnome.Showtime.desktop
video/ogg=org.gnome.Showtime.desktop
video/x-ms-wmv=org.gnome.Showtime.desktop
video/x-flv=org.gnome.Showtime.desktop
image/jpeg=org.gnome.Loupe.desktop
image/png=org.gnome.Loupe.desktop
image/gif=org.gnome.Loupe.desktop
image/heic=org.gnome.Loupe.desktop
image/heif=org.gnome.Loupe.desktop
image/tiff=org.gnome.Loupe.desktop
image/webp=org.gnome.Loupe.desktop
image/bmp=org.gnome.Loupe.desktop
image/avif=org.gnome.Loupe.desktop
image/jxl=org.gnome.Loupe.desktop
image/svg+xml=org.gnome.Loupe.desktop
# Programs downloaded as AppImage: install with Gear Lever (makes them executable and adds
# them to the app menu) instead of the disk tool, which offers to overwrite a drive
application/vnd.appimage=it.mijorus.gearlever.desktop
application/x-iso9660-appimage=it.mijorus.gearlever.desktop

[Removed Associations]
application/vnd.appimage=gnome-disk-image-writer.desktop;gnome-disk-image-mounter.desktop;
application/x-iso9660-appimage=gnome-disk-image-writer.desktop;gnome-disk-image-mounter.desktop;
