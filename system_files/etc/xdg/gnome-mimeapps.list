# Which app opens a file on double-click (PDF in Papers, not in Firefox)
[Default Applications]
application/pdf=org.gnome.Papers.desktop
video/mp4=org.gnome.Showtime.desktop
video/quicktime=org.gnome.Showtime.desktop
video/x-msvideo=org.gnome.Showtime.desktop
video/x-matroska=org.gnome.Showtime.desktop
video/webm=org.gnome.Showtime.desktop
video/mpeg=org.gnome.Showtime.desktop
video/3gpp=org.gnome.Showtime.desktop
video/x-m4v=org.gnome.Showtime.desktop
video/ogg=org.gnome.Showtime.desktop
video/x-ms-wmv=org.gnome.Showtime.desktop
video/x-flv=org.gnome.Showtime.desktop
image/jpeg=org.gnome.Loupe.desktop
image/png=org.gnome.Loupe.desktop
image/gif=org.gnome.Loupe.desktop
image/heic=org.gnome.Loupe.desktop
image/heif=org.gnome.Loupe.desktop
image/tiff=org.gnome.Loupe.desktop
image/webp=org.gnome.Loupe.desktop
image/bmp=org.gnome.Loupe.desktop
image/avif=org.gnome.Loupe.desktop
image/jxl=org.gnome.Loupe.desktop
image/svg+xml=org.gnome.Loupe.desktop
# Programs downloaded as AppImage: install with Gear Lever (makes them executable and adds
# them to the app menu) instead of the disk tool, which offers to overwrite a drive
application/vnd.appimage=it.mijorus.gearlever.desktop
application/x-iso9660-appimage=it.mijorus.gearlever.desktop

# Windows/Mac programs, phone apps, installer packages and disk images: a plain notice
# instead of an error or a disk tool that offers to overwrite a drive
application/x-ms-dos-executable=senioren-hinweis.desktop
application/x-msdownload=senioren-hinweis.desktop
application/vnd.microsoft.portable-executable=senioren-hinweis.desktop
application/x-msi=senioren-hinweis.desktop
application/x-ms-installer=senioren-hinweis.desktop
application/x-ms-shortcut=senioren-hinweis.desktop
application/x-bat=senioren-hinweis.desktop
application/x-msdos-program=senioren-hinweis.desktop
application/x-apple-diskimage=senioren-hinweis.desktop
application/x-xar=senioren-hinweis.desktop
application/vnd.android.package-archive=senioren-hinweis.desktop
application/x-raw-disk-image=senioren-hinweis.desktop
application/x-cd-image=senioren-hinweis.desktop
application/x-rpm=senioren-hinweis.desktop
application/vnd.debian.binary-package=senioren-hinweis.desktop
application/x-shellscript=senioren-hinweis.desktop
application/x-executable=senioren-hinweis.desktop
application/vnd.flatpak.ref=senioren-hinweis.desktop
application/vnd.flatpak=senioren-hinweis.desktop

# Audio (e.g. WAV and MP3 downloads) and plain text
audio/x-wav=org.gnome.Decibels.desktop
audio/wav=org.gnome.Decibels.desktop
audio/vnd.wave=org.gnome.Decibels.desktop
audio/mpeg=org.gnome.Decibels.desktop
audio/mp3=org.gnome.Decibels.desktop
audio/mp4=org.gnome.Decibels.desktop
audio/x-m4a=org.gnome.Decibels.desktop
audio/aac=org.gnome.Decibels.desktop
audio/ogg=org.gnome.Decibels.desktop
audio/x-vorbis+ogg=org.gnome.Decibels.desktop
audio/opus=org.gnome.Decibels.desktop
audio/flac=org.gnome.Decibels.desktop
audio/x-flac=org.gnome.Decibels.desktop
audio/x-aiff=org.gnome.Decibels.desktop
audio/webm=org.gnome.Decibels.desktop
text/plain=org.gnome.TextEditor.desktop

