# Senioren-OS als Live-System (zum Ausprobieren und für die Datenrettung).
# Bauen mit: podman build --cap-add sys_admin --security-opt label=disable --squash
ARG BASE=ghcr.io/paulwilke/senioren-os:latest
FROM ${BASE}
COPY src /src
RUN --mount=type=cache,target=/var/tmp/libdnf5,id=libdnf5 /src/build-live.sh
RUN rm -rf /src
