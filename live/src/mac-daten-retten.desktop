[Desktop Entry]
Type=Application
Name=Mac-Daten retten
Comment=Benutzerdaten von einer alten Mac-Platte auf eine externe Platte kopieren
Icon=drive-harddisk
Exec=ptyxis --new-window -x "bash -c 'sudo /usr/bin/mac-daten-retten; echo; read -p \"Fenster mit Enter schließen …\"'"
Terminal=false
Categories=System;
